# Configuração da API de Pedidos e Entregas (somente variáveis de ambiente).
# Nenhum segredo é necessário nesta versão didática.
#
# Uso (sem sobrescrever outros arquivos .env do diretório):
#   cp .env.example .env.api
#   uvicorn app.main:app --host 127.0.0.1 --port 8000 --env-file .env.api

# ---------------------------------------------------------------------------
# SIMULAÇÃO DE FALHAS — SOMENTE DESENVOLVIMENTO / DEMONSTRAÇÃO
# Desabilitada por padrão. Nunca habilite em uma implantação pública.
# ---------------------------------------------------------------------------

# Chave geral. Se for "false" (padrão), todas as opções abaixo e os
# cabeçalhos X-Dev-* são ignorados.
API_SIMULACAO_DEV=false

# Com a chave geral ligada: todo /pedidos* responde HTTP 503.
API_FORCAR_503=false

# Com a chave geral ligada: atraso (em segundos, máx. 60) antes de responder.
# Útil para demonstrar timeout no cliente HTTP (ex.: timeout de 5 s no cliente).
API_ATRASO_SEGUNDOS=0

# Com a chave geral ligada, o cliente também pode pedir a falha por requisição:
#   X-Dev-Simular: 503      -> responde 503 só nessa requisição
#   X-Dev-Atraso: 8         -> demora 8 s só nessa requisição

# ---------------------------------------------------------------------------
# PERSISTÊNCIA DOS PEDIDOS CADASTRADOS (POST /pedidos)
# ---------------------------------------------------------------------------
# Arquivo JSON local. Padrão: dados/pedidos_criados.json (ignorado pelo Git).
# Os pedidos fictícios originais nunca são gravados neste arquivo.
# PEDIDOS_ARQUIVO=

# ---------------------------------------------------------------------------
# INTEGRAÇÃO COM O n8n (Webhook chamado após POST /pedidos)
# ---------------------------------------------------------------------------
# Desabilitada por padrão. Habilite explicitamente para a demonstração.
N8N_WEBHOOK_ENABLED=false

# A API roda no Ubuntu e o n8n (Docker) publica a porta 5678 no Ubuntu,
# então 127.0.0.1 funciona. Em produção do n8n use /webhook/ (não /webhook-test/).
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/novo-pedido

# Enviado no cabeçalho X-Aula-Token. Use um valor qualquer só da aula (não reutilize
# senhas reais) e configure o MESMO valor na autenticação do Webhook no n8n.
# Se ficar vazio, o cabeçalho não é enviado. Nunca aparece em logs nem em respostas.
N8N_WEBHOOK_TOKEN=

# Tempo máximo de espera pelo n8n (opcional; padrão 3, limitado a 0.5–10 segundos).
# N8N_WEBHOOK_TIMEOUT_SEGUNDOS=3
