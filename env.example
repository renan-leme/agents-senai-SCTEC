# ==========================================================
# Detetive de Incidentes — Aula 1
# Exemplo de configuracao: NAO contem credenciais reais.
# Copie este arquivo para .env e preencha somente sua chave.
# NUNCA envie o arquivo .env para um repositorio Git.
# ==========================================================

# Provedor de LLM: openai ou gemini.
# Deixe vazio para escolher ao executar o notebook (padrao: Gemini).
LLM_PROVIDER=

# ---------- OpenAI ----------
# Chave: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---------- Google Gemini ----------
# Chave: https://aistudio.google.com/api-keys
# Preencha GOOGLE_API_KEY OU GEMINI_API_KEY (nao precisa das duas).
# Se ambas estiverem preenchidas, GOOGLE_API_KEY tem prioridade.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# O Gradio inicia localmente pelo notebook; nao precisa de API key propria.
